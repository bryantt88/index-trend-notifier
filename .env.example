# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here

# Comma-separated chat ids to broadcast alerts to.
# Private chat = positive id; group/supergroup = negative id (e.g. -1001234567890).
# Use `python get_chat_id.py` to find a group's id.
TELEGRAM_CHAT_IDS=-1001234567890

# FutuOpenD gateway (defaults shown; usually no need to change)
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
